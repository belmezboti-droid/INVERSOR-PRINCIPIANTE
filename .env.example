# Copia este archivo como ".env" y rellena los valores. NUNCA subas .env a GitHub.

# "production" en el servidor público (activa cookies seguras, HSTS y comprobaciones estrictas)
NODE_ENV=development
PORT=4000

# Secreto para firmar las sesiones. Obligatorio en producción (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Carpeta donde se guarda la base de datos (en producción, un disco persistente)
DATA_DIR=./data

# Correos de las cuentas con permisos de moderación en el foro (separados por comas)
ADMIN_EMAILS=

# Consultor IA: tu clave de la API de Anthropic (console.anthropic.com). Si la dejas vacía, el consultor se desactiva.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Feeds RSS para los titulares en directo (separados por comas). Puedes añadir los de medios de tu país.
NEWS_FEEDS=https://feeds.bbci.co.uk/news/business/rss.xml,https://www.cnbc.com/id/100003114/device/rss/rss.html

# Número de proxies delante del servidor (Render, Railway, nginx: 1)
TRUST_PROXY=1

# Solo si sirves la web desde OTRO dominio distinto al del servidor (normalmente déjalo vacío)
ALLOWED_ORIGINS=
